# Decorador específico para Talento Humano
def talento_humano_requerido(f):
    from functools import wraps
    @wraps(f)
    def decorated_function(*args, **kwargs):
        if session.get('user_rol') != 'Talento humano':
            if request.path.startswith('/api/'):
                return jsonify({'status': 'error', 'msg': 'Acceso denegado. Solo Talento Humano.'}), 403
            flash("Acceso denegado. Este módulo es exclusivo para Talento Humano.", "error")
            return redirect(url_for('main.pantalla_principal'))
        return f(*args, **kwargs)
    return decorated_function


talento_humano_bp = Blueprint('talento_humano', __name__, url_prefix='/talento_humano')


def _json_fila(row):
    """Convierte una fila de BD a dict serializable (fechas ISO, Decimal -> float)."""
    out = {}
    for k, v in dict(row).items():
        if isinstance(v, (datetime.datetime, datetime.date)):
            out[k] = v.isoformat()
        elif isinstance(v, Decimal):
            out[k] = float(v)
        else:
            out[k] = v
    return out


