# ============================================================
@talento_humano_bp.route('/api/colaboradores/buscar')
@login_requerido
@talento_humano_requerido
def api_buscar_colaboradores():
    """Endpoint para TomSelect: busca colaboradores activos"""
    termino = request.args.get('q', '').strip()
    excluir = request.args.get('excluir', type=int)
    limite = request.args.get('limit', 20, type=int)

    if not termino or len(termino) < 2:
        return jsonify({'status': 'ok', 'results': []})

    resultados = Colaborador.buscar_para_jefe(termino, excluir, limite)
    data = [
        {
            'id': r['id'],
            'text': f"{r['nombre_completo']} ({r['cargo'] or 'Sin cargo'} - {r['area'] or 'Sin área'})",
            'num_doc': r['num_doc'],
            'cargo': r['cargo'],
            'area': r['area']
        }
        for r in resultados
    ]
    return jsonify({'status': 'ok', 'results': data})


