# CREAR COLABORADOR
# ============================================================
@talento_humano_bp.route('/colaboradores/crear', methods=['GET', 'POST'])
@login_requerido
@talento_humano_requerido
def crear_colaborador():
    if request.method == 'GET':
        return redirect(url_for('talento_humano.colaboradores'))

    # POST - Procesar formulario
    try:
        data = _form_a_dict(request.form)
        foto = request.files.get('foto_perfil')

        nuevo_id = Colaborador.create(data, session['user_id'], foto)
        flash(f"Colaborador creado exitosamente (ID: {nuevo_id})", "success")
        return redirect(url_for('talento_humano.colaboradores'))

    except ValueError as e:
        flash(str(e), "error")
    except Exception as e:
        current_app.logger.error(f"[ERROR CREAR COLABORADOR]: {e}")
        flash("Error interno al crear colaborador. Verifique los datos.", "error")

    # Si error, volver con datos en sesión para repoblar (opcional)
    return redirect(url_for('talento_humano.colaboradores'))


