# ============================================================
# HELPERS
# ============================================================
CAMPOS_BOOL_FORM = (
    'discapacidad', 'victima_conflicto', 'comunidad_lgtbi',
    'desplazado', 'tiene_servicios_publicos', 'tiene_internet',
    'epp_casco', 'epp_botas', 'epp_guantes', 'epp_gafas', 'epp_tapabocas', 'epp_overol',
    'epp_botas_dielectricas', 'epp_arnes', 'epp_chaleco_reflectivo', 'epp_proteccion_auditiva',
)

# Campos que llegan como múltiples valores (checkbox) y se guardan como texto separado por comas
CAMPOS_MULTI_FORM = ('tipo_discapacidad', 'servicios_publicos')


def _form_a_dict(form) -> dict:
    """Convierte request.form a dict con tipos correctos"""
    data = {}
    for key in form.keys():
        if key in CAMPOS_MULTI_FORM:
            continue  # se procesan aparte con getlist()
        value = form.get(key)
        if key in CAMPOS_BOOL_FORM:
            # Los <select> Sí/No envían "0"/"1"; los checkbox sólo llegan si están marcados
            data[key] = str(value).strip() not in ('', '0', 'false', 'False', 'None')
        elif key in ('estrato', 'jefe_inmediato_id'):
            data[key] = int(value) if value and value.isdigit() else None
        else:
            data[key] = value.strip() if isinstance(value, str) else value

    # Selección múltiple -> "LUZ, CELULAR"
    for key in CAMPOS_MULTI_FORM:
        seleccion = [v.strip() for v in form.getlist(key) if v and v.strip()]
        data[key] = ', '.join(seleccion) if seleccion else None

    # El booleano histórico se mantiene sincronizado con la nueva lista
    data['tiene_servicios_publicos'] = bool(data.get('servicios_publicos'))

    return data


