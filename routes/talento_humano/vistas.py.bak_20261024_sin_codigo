# EDITAR COLABORADOR
# ============================================================
@talento_humano_bp.route('/colaboradores/editar/<int:id>', methods=['GET', 'POST'])
@login_requerido
@talento_humano_requerido
def editar_colaborador(id):
    colaborador = Colaborador.get_by_id(id)
    if not colaborador:
        flash("Colaborador no encontrado", "error")
        return redirect(url_for('talento_humano.colaboradores'))

    if request.method == 'GET':
        # Para GET, podríamos renderizar modal con datos precargados via JS
        # Pero en este patrón usamos modal único con JS, así que redirigimos
        return redirect(url_for('talento_humano.colaboradores'))

    # POST - Actualizar
    try:
        data = _form_a_dict(request.form)
        data['id'] = id
        foto = request.files.get('foto_perfil')
        eliminar_foto = request.form.get('eliminar_foto') == '1'

        exito = Colaborador.update(id, data, session['user_id'], foto, eliminar_foto)
        if exito:
            flash("Colaborador actualizado exitosamente", "success")
        else:
            flash("No se pudo actualizar (¿colaborador inexistente?)", "error")

    except ValueError as e:
        flash(str(e), "error")
    except Exception as e:
        current_app.logger.error(f"[ERROR EDITAR COLABORADOR]: {e}")
        flash("Error interno al actualizar colaborador.", "error")

    return redirect(url_for('talento_humano.colaboradores'))


