@talento_humano_bp.route('/colaboradores')
@login_requerido
@talento_humano_requerido
def colaboradores():
    """Vista principal con tabla, buscador y paginación"""
    # Filtros desde query params
    filtros = {
        'busqueda': request.args.get('busqueda', '').strip(),
        'estado': request.args.get('estado', ''),
        'area': request.args.get('area', ''),
        'cargo': request.args.get('cargo', ''),
    }
    # Limpiar vacíos
    filtros = {k: v for k, v in filtros.items() if v}

    pagina = request.args.get('pagina', 1, type=int)
    por_pagina = 50

    colaboradores_lista, total = Colaborador.get_all(filtros, pagina, por_pagina)
    total_paginas = (total + por_pagina - 1) // por_pagina

    # Listas para filtros dropdown
    areas = Colaborador.get_areas_unicas()
    cargos = Colaborador.get_cargos_unicos()
    estados = Colaborador.ESTADOS

    return render_template(
        'talento_humano/colaboradores.html',
        colaboradores=colaboradores_lista,
        filtros=filtros,
        pagina=pagina,
        total_paginas=total_paginas,
        total=total,
        areas=areas,
        cargos=cargos,
        estados=estados
    )


