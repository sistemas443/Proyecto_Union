@talento_humano_bp.route('/api/documentos/<int:id>/archivo')
@login_requerido
@talento_humano_requerido
def api_documento_archivo(id):
    """Ver (inline) o descargar (?descargar=1) el archivo"""
    doc = Documento.get_by_id(id)
    if not doc:
        abort(404)

    ruta = Documento.ruta_absoluta(doc['ruta_archivo'])
    if not os.path.exists(ruta):
        abort(404)

    descargar = request.args.get('descargar') == '1'
    return send_file(
        ruta,
        mimetype=doc.get('mime_type') or 'application/octet-stream',
        as_attachment=descargar,
        download_name=doc.get('nombre_original') or os.path.basename(ruta),
    )


