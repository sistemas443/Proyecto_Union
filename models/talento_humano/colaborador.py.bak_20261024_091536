# --- EXTENSIÓN PARSE_EMPTY PARA CAST INT ---
def parse_empty(value, cast_int=False):
    """Extiende base.parse_empty con opción cast_int"""
    if value is None or str(value).strip() == '':
        return None
    if cast_int:
        try:
            return int(value)
        except (ValueError, TypeError):
            return None
    return value